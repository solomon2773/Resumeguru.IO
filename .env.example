# ── CareerOS Configuration ──────────────────────────────────────────────────
# Copy this file to .env and customize as needed.
# Most settings have sensible defaults for single-user local development.

# Debug mode
DEBUG=false

# ── LLM Provider (choose one) ──────────────────────────────────────────────

# Option 1: NVIDIA NIM (DGX Spark or NVIDIA GPU with NIM containers)
# NIM_API_BASE=http://localhost:8010
# NIM_MODEL=meta/llama-3.1-70b-instruct
# NIM_API_KEY=

# Option 2: Local LLM (Apple Silicon / CPU - place .gguf in ./models/)
# LOCAL_MODEL_PATH=./models/llama-3.2-3b-instruct.Q4_K_M.gguf

# Option 3: OpenAI-compatible API (external fallback)
# OPENAI_API_KEY=sk-...
# OPENAI_API_BASE=
# OPENAI_MODEL=gpt-4o

# ── PersonaPlex (NVIDIA GPU only) ──────────────────────────────────────────
# PERSONAPLEX_URL=http://localhost:8020
# RIVA_SPEECH_URL=localhost:50051
