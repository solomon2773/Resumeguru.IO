# CareerOS Backend Configuration
# Copy to .env and customize

# Debug mode
DEBUG=false

# Database (SQLite - no config needed for default)
# DATABASE_URL=sqlite:///./data/careeros.db

# NVIDIA NIM (for DGX Spark / NVIDIA GPU)
# NIM_API_BASE=http://localhost:8010
# NIM_MODEL=meta/llama-3.1-70b-instruct
# NIM_API_KEY=

# PersonaPlex Avatar (for NVIDIA GPU)
# PERSONAPLEX_URL=http://localhost:8020
# PERSONAPLEX_AVATAR_ID=hannah

# Riva Speech Services (for NVIDIA GPU)
# RIVA_SPEECH_URL=localhost:50051
# RIVA_TTS_VOICE=English-US.Female-1
# RIVA_ASR_LANGUAGE=en-US

# Local LLM (for Apple Silicon / CPU fallback)
# LOCAL_MODEL_PATH=./models/llama-3.2-3b-instruct.Q4_K_M.gguf

# OpenAI-compatible API (external fallback)
# OPENAI_API_KEY=sk-...
# OPENAI_API_BASE=
# OPENAI_MODEL=gpt-4o

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
